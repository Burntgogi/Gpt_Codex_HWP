{
  "name": "gpt-codex-hwp-repository",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "npm@10.9.7",
  "engines": { "node": ">=22" },
  "config": {
    "productId": "gpt-codex-hwp",
    "displayName": "Gpt_Codex_HWP",
    "developerName": "Gpt_Codex_HWP contributors",
    "marketplaceName": "gpt-codex-hwp-local",
    "legacyUninstallSelector": "hwp-korean-docs@hwp-local",
    "codexBuildId": "20260722040551"
  },
  "scripts": {
    "build": "npm --prefix packages/gpt-codex-hwp run build",
    "doctor": "node scripts/doctor.mjs",
    "github:policy:check": "node scripts/github-repository-policy.mjs --check",
    "github:policy:plan": "node scripts/github-repository-policy.mjs --plan",
    "github:policy:apply": "node scripts/github-repository-policy.mjs --apply",
    "security:scan-tree": "node scripts/public-content-policy.mjs --tree",
    "security:scan-history": "node scripts/scan-public-history.mjs",
    "sync:metadata": "node scripts/sync-project-metadata.mjs --write",
    "check:metadata": "node scripts/sync-project-metadata.mjs --check",
    "runtime:write": "node scripts/project-runtime.mjs --write",
    "runtime:check": "node scripts/project-runtime.mjs --check",
    "release:artifacts": "node packages/gpt-codex-hwp/release-scripts/build-release-artifacts.mjs",
    "release:verify": "node scripts/release-verify.mjs",
    "verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
    "verify:compact-runtime": "node packages/gpt-codex-hwp/release-scripts/verify-compact-runtime.mjs",
    "verify:dependencies": "node scripts/verify-installed-dependencies.mjs",
    "verify:source-dependencies": "node scripts/verify-installed-dependencies.mjs --source-only",
    "test:repository": "node --test tests/*.test.mjs",
    "test:source": "npm --prefix packages/gpt-codex-hwp test",
    "test": "npm run test:repository && npm run test:source",
    "test:python": "npm --prefix packages/gpt-codex-hwp run test:python"
  }
}
