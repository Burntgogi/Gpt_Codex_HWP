{
  "name": "gpt-codex-hwp",
  "version": "0.2.1",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-build-assets.mjs",
    "doctor": "node dist/doctor.js",
    "pretest": "npm run build",
    "test": "node ../../scripts/source-node-tests-isolated.mjs",
    "test:focused": "node --import tsx --test --test-concurrency=1",
    "test:python": "python -m unittest scripts.hwpx-safe-edit.test_hwpx_safe_edit",
    "prebenchmark:documents": "npm run build",
    "benchmark:documents": "node --import tsx benchmarks/document-engine-benchmark.mjs",
    "diagnose:hosted": "node --import tsx benchmarks/hosted-platform-diagnostics.mjs",
    "release:artifacts": "node release-scripts/build-release-artifacts.mjs",
    "verify:compact-runtime": "node release-scripts/verify-compact-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@xmldom/xmldom": "0.9.10",
    "cfb": "1.2.2",
    "jszip": "3.10.1",
    "kordoc": "file:vendor/kordoc-core",
    "sharp": "0.34.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@rhwp/core": "0.7.17"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
